{
  "sourceLanguage": "ja",
  "strings": {
    "%@": {
      "shouldTranslate": false
    },
    "%@（%@ × %@）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@ × %3$@)"
          }
        }
      }
    },
    "%@（モニターと同じ）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Same as Monitor)"
          }
        }
      }
    },
    "%@（画面の点と同じ）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Same as Panel Pixels)"
          }
        }
      }
    },
