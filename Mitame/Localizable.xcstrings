      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Getting ready…"
          }
        }
      }
    },
    "HiDPI にする": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HiDPI"
          }
        }
      }
    },
    "Mac を開くと HiDPI になります": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your Mac to turn on HiDPI"
          }
        }
      }
    },
    "Mitame について": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About Mitame"
          }
        }
      }
    },
    "モニター": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor"
          }
        }
      }
    },
    "モニターをつなぐと HiDPI になります": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a monitor to turn on HiDPI"
          }
        }
      }
    },
    "ログイン時に起動": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at Login"
          }
        }
      }
    },
